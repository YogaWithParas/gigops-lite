# Copy this file to .env in the same folder (api/.env) and fill in real local values.
# .env is git-ignored and must never be committed. This .env.example file holds only
# placeholders and is safe to commit.

PORT=4000

# Quote-to-Cash Bridge: local Postgres for the sync ledger (Stage 2 onward).
# Started with: cd api && docker compose -f docker-compose.bridge-db.yml up -d
BRIDGE_DB_USER=gigops_bridge
BRIDGE_DB_PASSWORD=replace-with-a-local-password
BRIDGE_DB_NAME=gigops_bridge
BRIDGE_DB_PORT=5433
BRIDGE_DATABASE_URL=postgresql://gigops_bridge:replace-with-a-local-password@localhost:5433/gigops_bridge

# ERPNext (local Docker Desktop instance, project "frappe_docker"). No secrets here --
# the integration user's API key and secret are added separately at Stage 4 (see
# docs/bridge/NEEDS_YOU.md) and must never be committed.
ERPNEXT_URL=http://localhost:8080
